
# ─── ERP HeadCoach (fase 0) ───────────────────────────────────────────────
# Credenciais que ficavam hardcoded no código (obrigatórias agora)
TOTVS_CLIENT_ID=
TOTVS_CLIENT_SECRET=
TOTVS_USERNAME=
TOTVS_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EVOLUTION_DB_PASSWORD=
# Sync TOTVS → HeadCoach (cadastros): liga/desliga os crons
ERP_SYNC_ENABLED=true
# Empresas próprias usadas em preços/vendedores (padrão: config/sefazFiliais.js)
ERP_SYNC_EMPRESAS=
# Tipos de preço/custo e empresas de custo (padrão: 1 / 1 / 1)
ERP_SYNC_PRECO_CODES=1
ERP_SYNC_CUSTO_CODES=1
ERP_SYNC_CUSTO_EMPRESAS=1
# Tabelas de preço a espelhar (vazio = não sincroniza)
ERP_SYNC_TABELAS_PRECO=
# Meses de contas a pagar varridos para derivar itens de despesa / centros de custo
ERP_SYNC_DESPESAS_MESES=24
# Pausa entre chamadas ao TOTVS (ms) e tamanho do lote de upsert
ERP_TOTVS_DELAY_MS=150
ERP_UPSERT_CHUNK=500
# Worker do outbox HeadCoach → TOTVS
ERP_OUTBOX_ENABLED=true
ERP_OUTBOX_LOTE=20
# ─── ERP HeadCoach fase 1 (marco 0 = 17/10/2026 00:00 BRT) ────────────────
ERP_MARCO_ZERO=2026-10-17T03:00:00Z
# Contas a pagar: janelas móveis do job (dias)
ERP_AP_JANELA_EMISSAO_DIAS=120
ERP_AP_JANELA_LIQUIDACAO_DIAS=10
# Contas a receber: janelas de segurança do job (dias)
ERP_AR_JANELA_EMISSAO_DIAS=3
ERP_AR_JANELA_PAGAMENTO_DIAS=3
# Vendas: saldo de bônus/cashback (consulta por CPF)
ERP_BONUS_CONCORRENCIA=3
ERP_BONUS_REVALIDAR_LOTE=500
ERP_BONUS_REVALIDAR_HORAS=24
# Tentativas de leitura no TOTVS em 5xx/timeout (escritas nunca repetem)
ERP_TOTVS_TENTATIVAS=3
# ─── WhatsApp CONTAS A PAGAR (uazapi, servidor techcrosby) ────────────────
# O HeadCoach controla SÓ a instância "CONTAS A PAGAR". Use o token da própria
# instância (não o admintoken). Alternativa: WHATSAPP_CP_ADMIN_TOKEN resolve o
# token pelo nome da instância em /instance/all.
WHATSAPP_CP_BASE_URL=https://techcrosby.uazapi.com
WHATSAPP_CP_TOKEN=
WHATSAPP_CP_INSTANCE=CONTAS A PAGAR
WHATSAPP_CP_ADMIN_TOKEN=
# Segredo exigido na query (?s=) do receptor público POST /api/whatsapp-cp/webhook/receber
WHATSAPP_CP_WEBHOOK_SECRET=
# ─── JOJO — assistente fiscal no grupo WhatsApp do Contas a Pagar ─────────
# Responde no grupo pela instância CONTAS A PAGAR quando chamada ("jojo").
# IA: com ANTHROPIC_API_KEY usa Claude (pago por uso); sem ela usa o provedor do
# chat (GROQ_API_KEY grátis → OPENAI_API_KEY → XAI_API_KEY).
JOJO_ENABLED=true
JOJO_GRUPO_CHATID=120363414933413909@g.us
JOJO_NUMERO_AUTORIZADOR=5584987187425
JOJO_MODEL=claude-opus-5-5
# 0 = só webhook; >0 = também consulta o grupo a cada N segundos (sem URL pública)
JOJO_POLL_SEGUNDOS=0
JOJO_CONTEXTO_MENSAGENS=30
# ─── BRUCE — assistente do Contas a Receber no grupo "BRUCE - CAR HEADCOACH" ─
# Mesmas regras da JOJO (mesma instância CONTAS A PAGAR, mesmo autorizador).
BRUCE_ENABLED=true
BRUCE_GRUPO_CHATID=120363411253432671@g.us
BRUCE_NUMERO_AUTORIZADOR=5584987187425
BRUCE_MODEL=claude-opus-5-5
BRUCE_POLL_SEGUNDOS=0
BRUCE_CONTEXTO_MENSAGENS=30
# ─── THEO — assistente do Contas a Pagar (Wendy) no grupo "THEO - CAP HEADCOACH" ─
# Mesmas regras da JOJO/BRUCE (mesma instância CONTAS A PAGAR, mesmo autorizador).
THEO_ENABLED=true
THEO_GRUPO_CHATID=120363432001142287@g.us
THEO_NUMERO_AUTORIZADOR=5584987187425
THEO_MODEL=claude-opus-5-5
THEO_POLL_SEGUNDOS=0
THEO_CONTEXTO_MENSAGENS=30
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# ─── JOJO job 5min (lê o grupo do Contas a Pagar, SEM IA) ─────────────────
# Reage por regra: planilha de observações → cruzamento; "SUBIR MM/AAAA" grava.
JOJO_GRUPO_JOB_ENABLED=false
JOJO_GRUPO_JOB_CRON=*/5 * * * *
JOJO_NUMEROS_AUTORIZADOS=5584987187425,558496280021,558487057257
JOJO_IMPORT_CD_USUARIO=
# ─── DRE Auditoria — leitura dos Contratos PJ do Dryland (área DP) ────────
# Jeito simples (sem mexer no Supabase do Dryland): usuário/senha de um login
# do DP (dp.html). O backend faz dp_login → dp_pj_listar → dp_logout.
DRYLAND_DP_USUARIO=
DRYLAND_DP_SENHA=
# Alternativa: chave da RPC dp_pj_listar_headcoach (exige rodar
# migrations/dryland/dp_pj_listar_headcoach.sql no Dryland)
DRYLAND_DP_KEY=
# Portadores TOTVS cujas faturas entram na remessa de boletos Pagar.me
PAGARME_PORTADORES_REMESSA=1020,1098,1021
# ─── Pagar.me: duas contas ────────────────────────────────────────────────
# Crosby (FERREIRA COMERCIO E CONFECCOES) = PAGARME_SECRET_KEY (já existente)
# FA MODA (Fábio) = chave abaixo. Com ela setada, TODA emissão nova sai pela FA MODA
# (ou force com PAGARME_CONTA_EMISSAO=crosby|fabio). Retorno e cancelamento usam a
# conta de cada boleto (pagarme_boletos.conta).
PAGARME_SECRET_KEY_FABIO=
PAGARME_CONTA_EMISSAO=
# Banco/agência/conta do repasse da FA MODA para a baixa no TOTVS (se vazio, usa PAGARME_BAIXA_BANCO)
PAGARME_BAIXA_BANCO_FABIO=
# Acréscimo fixo (R$) somado ao valor da fatura em todo boleto Pagar.me emitido = tarifa de emissão repassada (0 desliga); vai impresso no boleto
PAGARME_BOLETO_ACRESCIMO=2.99

# ─── Ponte: Solicitações de Baixa do link do Dryland → aba Solicitações de Baixa ───
# Usuário dedicado da tela de cobrança do Dryland (cob_login). Sem os dois a ponte fica desligada.
DRYLAND_COB_USUARIO=
DRYLAND_COB_SENHA=
# DRYLAND_BAIXAS_DIAS=60           # janela lida no Dryland
# DRYLAND_BAIXAS_INTERVALO_MIN=10  # job

# ─── Baixa automática Pagar.me (cartão débito PAGARME, no dia do pagamento) ───
# Processa sozinha as Solicitações de Baixa de origem Pagar.me (Pix do BlueCard e
# boleto pago) como cartão débito PAGARME, NSU/autorização = dia do pagamento.
# 'on' liga (só com OK do Yago); qualquer outro valor = desligada (só prévia).
PAGARME_BAIXA_AUTO=off
# BAIXA_AUTO_INTERVALO_MIN=30
# SELF_URL=http://127.0.0.1:3000   # base da própria API para o self-call do invoices-settle

# Bot Stone Extratos (bots/stone-extratos) — mesmo valor no config.json do bot
STONE_BOT_TOKEN=...

# ─── Pix do Tadeu (Pix da Pagar.me fora do HeadCoach → Solicitações de Baixa) ───
PIX_TADEU_JOB=on             # off desliga; ligado cria as solicitações sozinho a cada PIX_TADEU_INTERVALO_MIN (só grava no HeadCoach)
# PIX_TADEU_INTERVALO_MIN=15
# PIX_TADEU_DIAS=30

# ─── VEVETO — agente de saldos/programação no grupo CONTAS A PAGAR CROSBY OFC (CEO Fábio) ───
VEVETO_ENABLED=true
# chatid fixo (opcional) — sem ele o agente acha o grupo pelo nome
VEVETO_GRUPO_CHATID=120363427439356982@g.us
VEVETO_GRUPO_NOME=CONTAS A PAGAR CROSBY OFC
VEVETO_NUMEROS_AUTORIZADORES=558487820986,5584987187425
VEVETO_MODEL=claude-opus-5-5
VEVETO_POLL_SEGUNDOS=0
VEVETO_CONTEXTO_MENSAGENS=30
# Relatório de saldos (imagem + programação da semana) 3x ao dia no mesmo grupo, marcando o Fábio
RELATORIO_SALDOS_ENABLED=true
RELATORIO_SALDOS_GRUPO_NOME=CONTAS A PAGAR CROSBY OFC
RELATORIO_SALDOS_MENCIONAR=558487820986
RELATORIO_SALDOS_CRON_FALLBACK=50 9 * * *;20 14 * * *;20 18 * * *
# Pagar.me 10 min antes do bot Stone (09:30/14:00/18:00)
PAGARME_SALDO_CRON=20 9 * * *;50 13 * * *;50 17 * * *

# Conciliação dos APROVADOS (marca PAGO o que saiu no extrato Stone/Sicredi, 09:50)
CONCILIACAO_APROVADOS_ENABLED=true
CONCILIACAO_APROVADOS_CRON=50 9 * * *
# janela de dias para trás que a conciliação varre (não só o dia anterior)
CONCILIACAO_APROVADOS_DIAS=45
